# TMDB: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
# Use real TMDB API in development (npm run dev). Omit or set to false for mock data.
# TMDB_USE_REAL_API=true

# SQLite for local dev (path relative to project root)
DATABASE_URL="file:./dev.db"

# NextAuth: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Admin — the User whose `name` exactly matches this becomes the admin
# (single-admin household app, no role table). Their signup auto-approves;
# they can approve/deny other pending signups at /admin/approvals.
ADMIN_NAME=your_name_here

# Production behind Docker / proxy: trust the Host header (same as auth trustHost)
# AUTH_TRUST_HOST=true

# Jellyfin — self-hosted homelab instance Streamy streams playback from
# directly (it already scans Radarr/Sonarr's output folders). Optional: when
# unset, titles never appear playable even once Radarr/Sonarr finish.
# JELLYFIN_URL=http://localhost:8096
# JELLYFIN_API_KEY=your_jellyfin_api_key_here

# qBittorrent — optional, only used so deleting a title also removes the
# torrent still seeding for it. Radarr/Sonarr stop tracking a torrent once
# they import it, so without this a deleted title lingers in the download
# client. When unset, deletes still work and qBittorrent's own share limits
# clean up the leftovers instead.
# QBITTORRENT_URL=http://localhost:8080
# QBITTORRENT_USER=admin
# QBITTORRENT_PASSWORD=your_qbittorrent_password_here

# Radarr (movies) — self-hosted homelab instance. Optional: when unset, the
# Request flow stays hidden and movie detail pages behave exactly as today.
# RADARR_URL=http://localhost:7878
# RADARR_API_KEY=your_radarr_api_key_here
# RADARR_ROOT_FOLDER=/movies
# RADARR_QUALITY_PROFILE_ID=1

# Sonarr (TV) — self-hosted homelab instance. Optional: when unset, the
# Request flow stays hidden and show detail pages behave exactly as today.
# SONARR_URL=http://localhost:8989
# SONARR_API_KEY=your_sonarr_api_key_here
# SONARR_ROOT_FOLDER=/tv
# SONARR_QUALITY_PROFILE_ID=1

# Shared secret Radarr/Sonarr must send back on their webhook calls, as a
# ?secret= query param on the webhook URL configured in each app's
# Settings -> Connect -> Webhook. Required for /api/webhooks/* to accept
# anything — unset means those endpoints reject all requests (fail closed).
# Generate with: openssl rand -base64 32
# MEDIA_WEBHOOK_SECRET=generate_a_random_string_here

# Optional — set in your shell if you don’t use npm scripts (not read automatically):
# NODE_OPTIONS=--max-old-space-size=8192

# Email alerting via a shared SNS topic. Optional -- when unset, the health
# check still runs and reports, it just doesn't email. One topic serves every
# project; ALERT_PROJECT is what distinguishes them in the subject line.
# The IAM credentials used here should be scoped to sns:Publish on this topic
# alone, not general-purpose AWS keys.
# ALERT_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:<account>:infra-alerts
# ALERT_PROJECT=streamy
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_scoped_key_here
# AWS_SECRET_ACCESS_KEY=your_scoped_secret_here

# Blog publishing to the portfolio site (jmrossi98/website). Optional: when
# unset, the Admin blog editor says so and publishes nothing.
#
# A fine-grained PAT scoped to that one repository, with TWO permissions:
#   Contents: Read and write      -- create the branch and commit the post
#   Pull requests: Read and write -- open the PR and merge it
# Contents alone gets as far as the commit and then fails at the PR. Publishing
# goes branch -> commit -> PR -> merge rather than pushing straight to master,
# so that a merge refused by branch protection leaves the post committed and
# the PR open to be merged by hand, instead of losing what was written.
#
# In CI these come from Actions secrets named BLOG_GITHUB_* rather than
# GITHUB_BLOG_*: GitHub refuses to create any secret whose name starts with
# GITHUB_. The env var names below are unaffected -- see .github/workflows/deploy.yml.
# GITHUB_BLOG_TOKEN=github_pat_your_token_here
# GITHUB_BLOG_REPO=jmrossi98/website
# GITHUB_BLOG_BRANCH=master
