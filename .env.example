# TMDB: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
# Use real TMDB API in development (npm run dev). Omit or set to false for mock data.
# TMDB_USE_REAL_API=true

# SQLite for local dev (path relative to project root)
DATABASE_URL="file:./dev.db"

# NextAuth: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Admin — the User whose `name` exactly matches this becomes the admin
# (single-admin household app, no role table). Their signup auto-approves;
# they can approve/deny other pending signups at /admin/approvals.
ADMIN_NAME=your_name_here

# Production behind Docker / proxy: trust the Host header (same as auth trustHost)
# AUTH_TRUST_HOST=true

# Jellyfin — self-hosted homelab instance Streamy streams playback from
# directly (it already scans Radarr/Sonarr's output folders). Optional: when
# unset, titles never appear playable even once Radarr/Sonarr finish.
# JELLYFIN_URL=http://localhost:8096
# JELLYFIN_API_KEY=your_jellyfin_api_key_here
# Jellyfin user id to sync watch progress with (e.g. the household's Roku
# app login) -- GET {JELLYFIN_URL}/Users with the API key above to find it.
# Optional: unset simply skips sync, Streamy's own progress still works.
# JELLYFIN_USER_ID=your_jellyfin_user_id_here

# qBittorrent — optional, only used so deleting a title also removes the
# torrent still seeding for it. Radarr/Sonarr stop tracking a torrent once
# they import it, so without this a deleted title lingers in the download
# client. When unset, deletes still work and qBittorrent's own share limits
# clean up the leftovers instead.
# QBITTORRENT_URL=http://localhost:8080
# QBITTORRENT_USER=admin
# QBITTORRENT_PASSWORD=your_qbittorrent_password_here

# Radarr (movies) — self-hosted homelab instance. Optional: when unset, the
# Request flow stays hidden and movie detail pages behave exactly as today.
# RADARR_URL=http://localhost:7878
# RADARR_API_KEY=your_radarr_api_key_here
# RADARR_ROOT_FOLDER=/movies
# RADARR_QUALITY_PROFILE_ID=1

# Sonarr (TV) — self-hosted homelab instance. Optional: when unset, the
# Request flow stays hidden and show detail pages behave exactly as today.
# SONARR_URL=http://localhost:8989
# SONARR_API_KEY=your_sonarr_api_key_here
# SONARR_ROOT_FOLDER=/tv
# SONARR_QUALITY_PROFILE_ID=1

# Shared secret Radarr/Sonarr must send back on their webhook calls, as a
# ?secret= query param on the webhook URL configured in each app's
# Settings -> Connect -> Webhook. Required for /api/webhooks/* to accept
# anything — unset means those endpoints reject all requests (fail closed).
# Generate with: openssl rand -base64 32
# MEDIA_WEBHOOK_SECRET=generate_a_random_string_here

# Optional — set in your shell if you don’t use npm scripts (not read automatically):
# NODE_OPTIONS=--max-old-space-size=8192

# Email alerting via a shared SNS topic. Optional -- when unset, the health
# check still runs and reports, it just doesn't email. One topic serves every
# project; ALERT_PROJECT is what distinguishes them in the subject line.
# The IAM credentials used here should be scoped to sns:Publish on this topic
# alone, not general-purpose AWS keys.
# ALERT_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:<account>:infra-alerts
# ALERT_PROJECT=streamy
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_scoped_key_here
# AWS_SECRET_ACCESS_KEY=your_scoped_secret_here

# Admin health check: flags when month-to-date AWS spend crosses this dollar
# ceiling. Optional -- unset means the check just reports "not configured",
# not a false alarm. Reuses the AWS_ACCESS_KEY_ID/SECRET above, which also
# needs the ce:GetCostAndUsage IAM permission added (not included by
# default, since that credential is otherwise scoped to sns:Publish only) --
# and Cost Explorer itself enabled once for the account (AWS Console ->
# Billing -> Cost Explorer).
# AWS_COST_ALERT_THRESHOLD_USD=15

# Blog publishing to the portfolio site (jmrossi98/website). Optional: when
# unset, the Admin blog editor says so and publishes nothing.
#
# A fine-grained PAT scoped to that one repository, with TWO permissions:
#   Contents: Read and write      -- create the branch and commit the post
#   Pull requests: Read and write -- open the PR and merge it
# Contents alone gets as far as the commit and then fails at the PR. Publishing
# goes branch -> commit -> PR -> merge rather than pushing straight to master,
# so that a merge refused by branch protection leaves the post committed and
# the PR open to be merged by hand, instead of losing what was written.
#
# In CI these come from Actions secrets named BLOG_GITHUB_* rather than
# GITHUB_BLOG_*: GitHub refuses to create any secret whose name starts with
# GITHUB_. The env var names below are unaffected -- see .github/workflows/deploy.yml.
# GITHUB_BLOG_TOKEN=github_pat_your_token_here
# GITHUB_BLOG_REPO=jmrossi98/website
# GITHUB_BLOG_BRANCH=master

# Prowlarr (indexer manager) — self-hosted, reachable over Tailscale. Optional:
# the Services panel reports Prowlarr as unconfigured unless BOTH are set.
# PROWLARR_URL=http://localhost:9696
# PROWLARR_API_KEY=your_prowlarr_api_key_here

# Tour watch: shared secret for the scheduled check endpoint, called by
# .github/workflows/page-watch.yml as ?secret=<value>. Required for page
# watching — /api/cron/page-watch fails closed and rejects everything when
# unset, since it makes the server fetch URLs on demand.
# Generate with: openssl rand -base64 32
# PAGE_WATCH_SECRET=generate_a_random_string_here

# --- Tour watch: anonymising egress (optional but recommended) ---
# Route the watcher's outbound requests through a VPN so they don't exit from
# this box's own IP, which DNS ties back to the site and its owner.
#
# PAGE_WATCH_PROXY_URL   HTTP proxy for watch fetches, e.g. the gluetun sidecar:
#                        http://gluetun:8888. When set, the page AND its
#                        robots.txt both go through it.
# PAGE_WATCH_REQUIRE_PROXY  "1" to fail closed: a watch fetch with no working
#                        proxy errors instead of leaking the real IP. Set this
#                        whenever anonymity actually matters.
# PAGE_WATCH_USER_AGENT  Overrides the default UA. The default is deliberately
#                        anonymous and names nothing; don't set this to anything
#                        that identifies you.
# PAGE_WATCH_PROXY_URL=http://gluetun:8888
# PAGE_WATCH_REQUIRE_PROXY=1
# PAGE_WATCH_USER_AGENT=

# gluetun VPN sidecar (docker-compose.prod.yml, "vpn" profile). The deploy only
# starts gluetun when VPN_SERVICE_PROVIDER is set. Values are the WireGuard
# shape; consult gluetun's wiki for a given provider.
#
# Credential providers (PIA, NordVPN): gluetun generates the WireGuard key from
# your account username and password -- there is no config to download.
# VPN_SERVICE_PROVIDER=private internet access
# VPN_TYPE=wireguard
# OPENVPN_USER=p1234567
# OPENVPN_PASSWORD=your_pia_password
# VPN_SERVER_REGIONS=Netherlands
#
# Config providers (Mullvad, Proton): a WireGuard key/address from a downloaded
# .conf instead of a username/password.
# VPN_SERVICE_PROVIDER=mullvad
# WIREGUARD_PRIVATE_KEY=your_wireguard_private_key
# WIREGUARD_ADDRESSES=10.x.x.x/32
# VPN_SERVER_COUNTRIES=

# Visitor map geolocation (optional). Free MaxMind GeoLite2 license key. When
# set, the app downloads the GeoLite2-City database once, caches it on the data
# volume, and locates visitor IPs on-box -- no IP is ever sent to a third party.
# Sign up free at maxmind.com, then create a license key.
# The map reports itself unconfigured when this is unset.
# MAXMIND_LICENSE_KEY=your_geolite2_license_key
# GEOIP_DIR=/app/data/geoip

# Tour watch: the overall "all dates" view is filtered to these locations
# (comma-separated, case-insensitive substring match on the venue text).
# Defaults to the DC area. Set empty to show dates everywhere.
# PAGE_WATCH_LOCATIONS=Tysons,Washington
