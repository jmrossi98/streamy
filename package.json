{
  "name": "streamy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "prisma generate && prisma migrate deploy && next dev --turbo",
    "dev:turbo": "next dev --turbo",
    "dev:webpack": "next dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 prisma generate && cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "npm run start:prod",
    "start:prod": "npm run build && prisma migrate deploy && node .next/standalone/server.js",
    "start:serve": "prisma migrate deploy && node .next/standalone/server.js",
    "start:watch": "nodemon --config nodemon.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:e2e": "npm run build && node e2e/assemble-standalone.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cost-explorer": "^3.1123.0",
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/client-sns": "^3.1117.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "hls.js": "^1.7.1",
    "leaflet": "^1.9.4",
    "maxmind": "^5.0.7",
    "next": "^16.3.2",
    "next-auth": "^4.24.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tar": "^7.5.22",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "nodemon": "^3.1.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
