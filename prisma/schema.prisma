generator client {
  provider      = "prisma-client-js"
  // Docker build/run = Debian (see Dockerfile). `native` = local dev (macOS/Windows).
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  // Unique: the name is the login identifier and, until now, nothing stopped
  // two accounts sharing one -- including the admin's. Uniqueness is what makes
  // "the account called X" a single, unambiguous thing.
  name              String    @unique
  password          String
  // Gates login until an admin approves the account.
  approved          Boolean   @default(false)
  // Authorization source of truth. Admin used to be derived from a name/env
  // comparison held in the JWT, so it could not be revoked without waiting out
  // a 30-day token. ADMIN_NAME now only bootstraps the first admin; every
  // authorization decision reads this column.
  isAdmin           Boolean   @default(false)
  // Hex avatar background (e.g. #e50914); assigned on create / backfill on login.
  avatarColor       String?
  createdAt         DateTime  @default(now())
  // Stamped on every password change, and mirrored into the JWT at sign-in.
  // Sessions are stateless 30-day tokens, so changing a password otherwise
  // leaves every existing session -- including an attacker's -- valid. The jwt
  // callback compares the two and drops tokens issued before the change.
  passwordChangedAt DateTime?

  watchlist           WatchlistItem[]
  watchlistShows      WatchlistShowItem[]
  watchlistGames      WatchlistGameItem[]
  watchlistFlashGames WatchlistFlashGameItem[]
  flashGameSaves      FlashGameSave[]
  watchlistChannels   WatchlistChannelItem[]
  hiddenChannels      HiddenChannelItem[]
  gameChannelChoices  GameChannelChoice[]
  progress            WatchProgress[]
  episodeProgress     EpisodeProgress[]
}

model WatchlistItem {
  userId  String
  movieId String
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([userId])
}

model WatchlistShowItem {
  userId  String
  showId  String
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, showId])
  @@index([userId])
}

model WatchProgress {
  userId          String
  movieId         String
  progressSeconds Int      @default(0)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([userId, updatedAt])
}

model EpisodeProgress {
  userId          String
  showId          String
  seasonNumber    Int
  episodeNumber   Int
  progressSeconds Int      @default(0)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, showId, seasonNumber, episodeNumber])
  @@index([userId, updatedAt])
}

// Shared/global per (tmdbId, mediaType) -- one Radarr/Sonarr library, not one
// per requesting user, so every user sees the same download status. Not tied
// to any User row: it represents library state, not personal data.
model MediaRequest {
  tmdbId      String
  // "movie" | "show"
  mediaType   String
  // Set for shows only, resolved via TMDB external_ids when the request is created.
  // Sonarr's webhook payload carries tvdbId, not tmdbId, so this is how we match it back.
  tvdbId      String?
  // "requested" | "downloading" | "available"
  status      String   @default("requested")
  // Radarr movie id / Sonarr series id -- used to look up live download progress.
  externalId  Int?
  requestedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([tmdbId, mediaType])
  @@index([tvdbId])
}

// A release Radarr/Sonarr grabbed that turned out to be unusable -- today only
// a "video" whose payload was an executable. Two jobs: the healer's blocklist
// expiry skips these so a fake is never eligible to be grabbed again, and the
// title's page can say why it is searching again (or why it found nothing)
// instead of leaving the viewer to guess.
model RejectedRelease {
  id           Int      @id @default(autoincrement())
  // "movie" | "show"
  mediaType    String
  // Radarr movie id / Sonarr series id, same as MediaRequest.externalId.
  externalId   Int
  // The release name exactly as the queue reported it.
  releaseTitle String
  // Torrent info hash, when the download client gave one.
  downloadId   String?
  // "executable"
  reason       String
  createdAt    DateTime @default(now())

  @@index([mediaType, externalId])
  @@index([downloadId])
}

// Every sign-in attempt, successful or not.
//
// Two consumers: the lockout check in front of the login form, and the
// security monitor, which alerts when failures spike. Before this table there
// was no throttle and no evidence -- a brute-force run against the admin
// account would have left no trace at all.
//
// Not linked to User on purpose: the interesting rows are attempts against
// names that don't exist, and a foreign key would make those unstorable.
model LoginAttempt {
  id                String   @id @default(cuid())
  // As submitted. May not correspond to any User row.
  name              String
  ip                String
  success           Boolean
  // "success" | "bad_password" | "unknown_user" | "not_approved" | "locked_out"
  outcome           String
  at                DateTime @default(now())
  // What was actually typed, "bad_password" rows only -- never for a
  // successful sign-in, which would mean storing a real, working password in
  // plaintext. Purged after 48h by purgeOldAttemptedPasswords(), well short
  // of this row's own 30-day retention: the row (who/when/outcome) is worth
  // keeping for the security monitor: a guessed value is not, once whatever
  // it was worth diagnosing (mistyped password vs. a bot vs. a real guess)
  // has had a couple of days to be noticed.
  attemptedPassword String?

  @@index([name, at])
  @@index([ip, at])
  @@index([at])
}

// Visits to the portfolio site, reported by a beacon on that site.
//
// jakobrossi.com is a static SPA on GitHub Pages with no server of its own, so
// it has nowhere to log. The beacon posts here instead, which keeps the
// portfolio a pure static site and puts the data on infrastructure that is
// already authenticated.
//
// Caveat worth knowing when reading the numbers: a JS beacon only sees clients
// that execute JavaScript. Bots, scanners, and curl are invisible to it. This
// answers "who is reading my site", not "what is probing my site".
model SiteVisit {
  id        String   @id @default(cuid())
  // Which property this came from, so other sites can report here later.
  site      String
  path      String
  ip        String
  // Best-effort, from the edge header if one is present.
  country   String?
  referrer  String?
  userAgent String?
  at        DateTime @default(now())

  @@index([at])
  @@index([site, at])
  @@index([ip, at])
}

/// A page being watched for changes. One row per URL.
model WatchedPage {
  id     String  @id @default(cuid())
  url    String  @unique
  /// Human name for the panel, e.g. "Fillmore listings".
  label  String
  /// The artist this page covers, when it covers exactly one. Left null for a
  /// venue or festival page listing many; those get their artist per date row.
  artist String?

  /// Narrows extraction to one container: "#tour" or ".listings". Whole page
  /// when null. Narrowing is what keeps nav and footer churn out of the diff.
  selector      String?
  /// Regex, one per line. Matching lines are dropped before hashing, so a
  /// clock or a rotating advert doesn't report a change on every check.
  ignorePattern String?
  /// Comma-separated. A keyword appearing in newly added content notifies.
  keywords      String?

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  /// Current state, overwritten each check.
  lastCheckedAt DateTime?
  lastStatus    String?
  lastError     String?
  contentHash   String?
  /// Normalized lines as last seen, newline-joined. This is the baseline the
  /// next check diffs against, so it is stored rather than re-fetched.
  content       String?
  failureCount  Int       @default(0)

  changes PageChange[]
  dates   TourDate[]

  @@index([enabled])
}

/// A detected change. History, so the panel can show what happened and when.
model PageChange {
  id          String      @id @default(cuid())
  pageId      String
  page        WatchedPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  detectedAt  DateTime    @default(now())
  /// One-line count, e.g. "3 added, 1 removed".
  summary     String
  /// The +/- lines, capped when written.
  diff        String
  /// Comma-separated keywords that appeared in this change, if any.
  keywordHits String?
  /// False when notification was skipped or failed, so it is visible that an
  /// email did not go out rather than assuming one did.
  notified    Boolean     @default(false)

  @@index([pageId, detectedAt])
  @@index([detectedAt])
}

/// A dated listing entry, as of the most recent successful check.
///
/// Replaced wholesale per page on each check rather than accumulated: the
/// overall view is meant to reflect what the sites say *now*, and keeping
/// removed dates around would make a cancelled show look live.
model TourDate {
  id     String      @id @default(cuid())
  pageId String
  page   WatchedPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// Denormalized from the page, or parsed per row for a multi-artist page.
  artist String
  /// ISO YYYY-MM-DD, or null when the line was dated too loosely to trust.
  date   String?
  detail String
  raw    String
  seenAt DateTime    @default(now())

  @@index([pageId])
  @@index([artist, date])
  @@index([date])
}

/// Small key/value store for runtime toggles the admin flips without a deploy.
/// First use: whether the tour watcher routes through the VPN egress proxy.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// One row per run of the download -> playback end-to-end check: grabs a
/// known-safe public-domain title through Radarr, waits for it to land, and
/// exercises the exact same HLS/seek chain a real viewer's player does,
/// before deleting it again. See lib/playbackCheck.ts.
///
/// A history table, not a single "last result" row (which Setting would have
/// been enough for) -- one bad run next to a long green streak reads very
/// differently from one bad run next to a week of red ones, and only a
/// history shows the difference.
model PlaybackCheckRun {
  id         String   @id @default(cuid())
  ranAt      DateTime @default(now())
  success    Boolean
  /// One line, e.g. "5/5 stages passed" or "failed at HLS transcode chain".
  summary    String
  /// Per-stage pass/fail detail, newline-separated.
  detail     String
  /// What this run downloaded and tested, e.g. "Night of the Living Dead (1968)".
  testTitle  String?
  durationMs Int?
  /// False when the failure alert was skipped or failed to send, so that is
  /// visible in the admin panel rather than assumed to have gone out.
  notified   Boolean  @default(false)

  @@index([ranAt])
}

/// One run of the scheduled health probes.
///
/// Separate from PlaybackCheckRun rather than a shared "check" table: that
/// one records a single end-to-end journey with stages, this records a set of
/// independent assertions, and merging them would mean a nullable column per
/// difference and a `kind` discriminator on every query.
/// One episode still waiting to be searched as part of an ordered season or
/// series request.
///
/// Sonarr is asked for episodes one at a time, in broadcast order, waiting for
/// each grab before starting the next, so torrents enter the download client
/// in episode order and a season becomes watchable from episode 1 (see
/// lib/sonarr.ts). For a 64-episode season that chain runs for the better part
/// of an hour.
///
/// It used to live only in the Node process that served the request, which
/// meant a deploy, a restart or a crash part-way through dropped every
/// remaining episode with no trace: episode 1 downloaded, the rest stayed
/// monitored and un-searched forever. Sonarr's own RSS sync only catches new
/// releases, so nothing ever picked them back up.
///
/// Persisting the queue makes the chain survive a restart -- it resumes on the
/// next page load, from wherever it stopped.
model PendingEpisodeSearch {
  id         String   @id @default(cuid())
  /// Sonarr's episode id. Unique so re-requesting a season already queued
  /// tops it up rather than searching anything twice.
  episodeId  Int      @unique
  seriesId   Int
  /// Index within the batch this was enqueued as, preserving broadcast order
  /// across a restart -- the ids themselves are not in airing order.
  position   Int
  enqueuedAt DateTime @default(now())
  /// Bumped on each failure so one permanently broken episode gets dropped
  /// instead of blocking everything queued behind it.
  attempts   Int      @default(0)

  @@index([enqueuedAt, position])
}

model HealthProbeRun {
  id         String   @id @default(cuid())
  ranAt      DateTime @default(now())
  success    Boolean
  /// One line, e.g. "6/6 probes passed" or "2 of 6 probes failed: ...".
  summary    String
  /// Per-probe PASS/FAIL/SKIP detail, newline-separated.
  detail     String
  durationMs Int?
  /// False when the failure alert was skipped or failed to send, so a silent
  /// alert is visible rather than assumed to have gone out.
  notified   Boolean  @default(false)
  /// What the automatic remediation actually did, newline-separated. Null
  /// when nothing was attempted, which is the common case.
  remediated String?

  @@index([ranAt])
}

/// A hand-picked artwork override for one ROM's Steam tile.
///
/// The Deck's steam_sync.py already auto-fetches artwork from SteamGridDB for
/// any game missing it, choosing the top-scoring match on its own. That's the
/// right default for an unattended import, but it has no way to be told "not
/// that one" -- and it picked wrong often enough to matter (a SpongeBob title
/// matching a 4-game compilation, "DreamWorks Madagascar" matching an
/// unrelated VR game) that overriding it needed to be possible without
/// editing files on the Deck by hand.
///
/// Keyed by the ROM's own identity (system + filename stem) rather than a
/// Steam appid: the appid is derived from the exe+name pair on the Deck and
/// isn't knowable here, and a ROM keeps this identity across re-imports and
/// across the .iso -> .chd conversion the compressor does. steam_sync.py
/// reads these via /api/games/artwork-overrides and prefers them over its own
/// automatic pick.
model GameArtwork {
  /// ES-DE system directory name, e.g. "ps2", "psx", "gamecube".
  system         String
  /// ROM filename without its extension, e.g. "DreamWorks Madagascar (USA) (v3.01)".
  romStem        String
  /// "grid" | "hero" | "logo" | "icon" -- the four assets a Steam tile uses.
  kind           String
  /// Full-size SteamGridDB asset URL to apply.
  imageUrl       String
  /// Which SteamGridDB game the picker resolved this ROM to, so the UI can
  /// reopen on the same game rather than re-searching by title every time.
  sgdbGameId     Int?
  /// Display title shown in the admin list -- the ROM stem is not always
  /// readable on its own.
  title          String?
  /// True for a deliberate pick made through the artwork picker; false for
  /// a background auto-match (see resolveAutoArt in src/lib/gameArtworkAuto.ts).
  /// Load-bearing for /api/games/artwork-overrides: only pickedManually rows
  /// are sent to the Deck, so an auto-match made here can never silently
  /// replace steam_sync.py's own, independently-computed automatic pick --
  /// only an actual human choice ever overrides what the Deck decides on its
  /// own. Defaults true so every row saved before this column existed (real
  /// picks, all of them) is correctly read as manual.
  pickedManually Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  @@id([system, romStem, kind])
}

/// When a game first appeared in the library, recorded by Streamy itself.
///
/// Exists because gamarr's own `added_at` cannot answer this: gamarr only
/// rebuilds its library on container restart, and that restart deletes and
/// re-inserts every scanned row -- so every game's timestamp collapses to
/// the moment of the last restart. Confirmed live: 162 games shared exactly
/// two `added_at` values, one minute apart, making "sort by date added"
/// effectively random.
///
/// Keyed like GameArtwork (system + romStem) rather than gameKey, since this
/// only means anything for a real file on disk. Rows are never updated after
/// insert -- first seen is first seen, and a gamarr restart must not move it.
model GameFirstSeen {
  system      String
  romStem     String
  firstSeenAt DateTime @default(now())

  @@id([system, romStem])
}

/// A game the admin has asked to delete, and whether mediabox has actually
/// removed the file yet.
///
/// Exists because Streamy runs on a different host from the ROM library and
/// has no filesystem access to it, while gamarr offers no delete endpoint at
/// all (only downloads and wishlist). So a delete is recorded here, takes
/// effect in the UI immediately (getGamesList filters these out), and
/// mediabox's own cron polls /api/games/pending-deletions and does the real
/// removal -- the same pull pattern already proven by artwork-overrides,
/// which avoids exposing a file-deletion endpoint on the network.
///
/// Rows are kept after deletion rather than removed: gamarr only rebuilds its
/// library on container restart, so a deleted game can briefly reappear in
/// its API afterwards, and a surviving row is what keeps it filtered out of
/// the UI in the meantime.
model GameDeletion {
  system      String
  romStem     String
  /// Display title at the time of deletion, for the audit log and for the
  /// mediabox-side log to name what it removed.
  title       String
  requestedBy String
  requestedAt DateTime  @default(now())
  /// Set once mediabox reports the files actually gone.
  deletedAt   DateTime?

  @@id([system, romStem])
}

/// A manually-corrected display title for one game, alongside GameArtwork.
///
/// Same identity as GameArtwork (system+romStem) rather than gameKey --
/// deliberately, since this is specifically for fixing a bad *library* title
/// (a raw ROM filename gamarr reports with no real title cleanup, or noise
/// romSearchTitle's generic stripping can't know is noise), and that only
/// ever exists once a real file is on disk. Survives gamarr rescans and
/// restarts same as GameArtwork does, since it lives in Streamy's own DB,
/// not gamarr's -- "across systems" in the sense that matters here: it isn't
/// wiped by anything gamarr does to its own library_items table.
model GameTitleOverride {
  system    String
  romStem   String
  title     String
  updatedAt DateTime @updatedAt

  @@id([system, romStem])
}

/// A game saved to a user's My List, alongside WatchlistItem (movies) and
/// WatchlistShowItem (shows).
///
/// Keyed by gameKey (see romNames.ts's gameKeyOf), not GameArtwork's
/// system+romStem: a game can be added to My List while still queued or
/// downloading, before either of those exist. gameKey is derived from title
/// alone and stays stable across a game's whole lifecycle (wishlisted ->
/// downloading -> owned), which is exactly what a list entry needs to survive.
model WatchlistGameItem {
  userId   String
  gameKey  String
  /// Display title snapshot, so a row still shows something sensible if the
  /// game is later removed from gamarr entirely (unlike movies/shows, there's
  /// no external catalog left to re-look the title up from).
  title    String
  platform String
  addedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, gameKey])
  @@index([userId])
}

/// One Flash game in the library.
///
/// Unlike ROMs, which are discovered by scanning mediabox's filesystem, a
/// Flash game is *imported* -- either from Flashpoint Archive (metadata,
/// artwork and the file itself) or by hand for a SWF Flashpoint has never
/// heard of. So the catalogue is a table here rather than a directory listing,
/// and the file on mediabox is only the payload.
model FlashGame {
  /// URL-safe identity, and the filename stem under /data/flash.
  slug         String  @id
  title        String
  /// Flashpoint's entry id, when it came from there. Null for a hand-added
  /// SWF -- which is a supported path, not a degraded one. Unique so browsing
  /// the archive can tell at a glance what is already known here.
  flashpointId String? @unique
  /// Andkon Arcade's own path for this game, "category/slug", when it came
  /// from there. Roughly half of Andkon's 4,686 games have no Flashpoint
  /// entry at all -- The Game Game and its sequels among them -- and Andkon
  /// serves their SWFs directly, so it is the download source for those.
  andkonPath   String? @unique
  developer    String  @default("")
  publisher    String  @default("")
  description  String  @default("")
  releaseDate  String  @default("")
  /// Comma-separated. The rows on the Games tab are built from these, so a
  /// genre grouping is data rather than code.
  tags         String  @default("")

  /// Where the SWF lives, or null when the game is known but not downloaded.
  ///
  /// Nullable because a row exists as soon as a game is *known* -- added to
  /// someone's list from the archive, say -- and the file arrives later, or
  /// never. Requiring a download before a game could be bookmarked would mean
  /// fetching gigabytes nobody asked for.
  fileName String?
  fileSize Int     @default(0)
  /// "local" (Streamy's own volume) or "mediabox" (the read-only share).
  /// Null while there is no file.
  storage  String?

  /// Read from the SWF header at import (see lib/swfMetadata.ts), so the
  /// player can be sized correctly and letterboxed to match before the movie
  /// has loaded.
  width           Int     @default(0)
  height          Int     @default(0)
  frameRate       Float   @default(0)
  swfVersion      Int     @default(0)
  /// Ruffle's AS1/AS2 support is its strongest path and its AS3 support is
  /// still incomplete, so this is the best predictor of whether a game will
  /// actually run -- better than Flashpoint's own `status`, which describes
  /// real Flash Player. Stored so the UI can warn before someone clicks.
  isActionScript3 Boolean @default(false)

  addedAt DateTime @default(now())

  watchlisted WatchlistFlashGameItem[]
  saves       FlashGameSave[]

  @@index([title])
}

/// One paid service, for the spend overview.
///
/// Manually entered, because there is no way to discover it. Nothing exposes
/// "what has this person signed up for" -- the whole reason the panel exists
/// is that the list had been forgotten, and a bill nobody remembers is exactly
/// the one no API will tell you about. What *can* be pulled live (AWS, via
/// Cost Explorer; OpenRouter, via its credits API) is fetched at render time
/// and never stored here.
model Subscription {
  id       String  @id @default(cuid())
  name     String
  /// Free text: "Usenet", "Infrastructure", "AI", "VPN"...
  category String  @default("")
  /// In dollars. Zero for a free tier worth listing so it isn't re-evaluated.
  cost     Float   @default(0)
  /// "monthly" | "yearly" | "metered" | "free".
  ///
  /// Metered is its own cadence rather than a monthly guess: OpenRouter and
  /// AWS vary, and folding a guess into the total would make the headline
  /// figure quietly wrong.
  cadence  String  @default("monthly")
  /// Where it is managed -- the thing you actually want when cancelling.
  url      String  @default("")
  notes    String  @default("")
  /// Kept rather than deleted when cancelled, so the history stays readable.
  active   Boolean @default(true)

  /// When this next bills, for the ones nothing can be asked automatically.
  ///
  /// The IPTV providers report their own expiry (Xtream player_api), the TLS
  /// cert carries its own notAfter, and the domain's is in RDAP -- those are
  /// read live and never stored here. This is for the rest: usenet blocks,
  /// anything bought as a term rather than a running subscription.
  renewsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A live TV channel on a user's My List.
///
/// Unlike the movie, show, game and Flash-game lists, there is no local row to
/// relate to: channels live in Jellyfin's tuner, not in this database, and the
/// lineup changes whenever the tuner's source does. So this stores the channel
/// id plus a name snapshot, and the row survives the channel disappearing --
/// which is the common case with a playlist-backed tuner, where ids churn.
model WatchlistChannelItem {
  userId    String
  channelId String
  /// Snapshot, so a list entry still reads sensibly if the channel is gone.
  name      String
  addedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@index([userId])
}

/// One viewer's "hide this channel from my lineup" choice.
///
/// Per-user, not global: a lineup pulled from a shared M3U playlist tuner
/// commonly carries hundreds of channels nobody in the household watches, and
/// one person's clutter is another's favorite. Same shape as
/// WatchlistChannelItem and for the same reason -- channels live in
/// Jellyfin's tuner, not this database, so a name snapshot keeps a hidden
/// entry's management UI readable if the channel ever disappears.
model HiddenChannelItem {
  userId    String
  channelId String
  name      String
  hiddenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@index([userId])
}

/// One viewer's save data for one Flash game.
///
/// Flash games save through SharedObject ("Flash cookies"), and Ruffle
/// implements that on top of the browser's localStorage -- which is per
/// device, per browser, and wiped by a routine cache clear. The whole point of
/// playing inside Streamy is that a save made on the TV is there on a laptop,
/// so the browser copy is treated as a cache and this row is the real one.
///
/// `data` is a JSON object of the localStorage entries Ruffle wrote, captured
/// wholesale rather than parsed. Ruffle has no public API for exporting
/// SharedObjects (ruffle-rs/ruffle#22409 is the open request), and its key
/// format is not a stable contract -- so this deliberately stores whatever it
/// produced without trying to understand it.
model FlashGameSave {
  userId    String
  slug      String
  /// JSON: { localStorageKey: value }.
  data      String
  updatedAt DateTime @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game FlashGame @relation(fields: [slug], references: [slug], onDelete: Cascade)

  @@id([userId, slug])
  @@index([userId])
}

/// A Flash game on a user's My List, alongside the movie/show/ROM equivalents.
/// Drives the pinned top row of the Games tab.
model WatchlistFlashGameItem {
  userId  String
  slug    String
  addedAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Cascades, unlike WatchlistGameItem's title snapshot: a Flash game's
  /// catalogue row lives here, so if it's gone there is nothing left to show.
  game FlashGame @relation(fields: [slug], references: [slug], onDelete: Cascade)

  @@id([userId, slug])
  @@index([userId])
}

/// Who did what, admin-mutating-action side: every write an admin makes
/// through Streamy's own routes (request/cancel/delete a title, approve a
/// user, queue/retry/remove a game download, save or clear a pick of
/// artwork) gets one row here. Read-only, surfaced in the Security panel --
/// same spirit as LoginAttempt (who's trying to get in) but for what an
/// already-admitted admin actually did once inside.
///
/// Exists because gamarr itself kept no such record: a real download
/// ("Ratchet and Clank") turned out to be explainable only by chance --
/// happened to still have a scheduler-attributed row in gamarr's own
/// activity_log -- and every *other* admin-mutating surface here had
/// exactly the same blind spot. This is deliberately Streamy-side rather
/// than trying to retrofit auditing into every third-party app on
/// mediabox individually; the routes here are the one place every one of
/// those apps' mutations already funnels through.
model AuditLogEntry {
  id        String   @id @default(cuid())
  /// Admin's own name -- not their user id, so a row still reads clearly
  /// after an account is renamed or deleted, same reasoning LoginAttempt's
  /// own `name` field uses.
  actorName String
  /// Short, stable, dot-namespaced verb: "game.queue", "game.artwork.save",
  /// "movie.request", "approval.approve", etc. -- grep-able, and stable
  /// across a UI label rewrite in a way a free-text summary wouldn't be.
  action    String
  /// The thing acted on, human-readable: a game/movie/show title, a
  /// username being approved. Not an id -- ids need a second lookup to
  /// mean anything, titles read directly in the panel.
  target    String
  /// Free text for whatever's specific to that action: platform, which
  /// artwork kind, old/new values. Empty string, not null, so every
  /// consumer can treat it uniformly.
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
}

/// One row per message sent to the admin assistant.
///
/// Separate from AuditLogEntry on purpose: that table records an *action*
/// somebody took, and most assistant turns take no action at all. This
/// records *use* -- who asked it something, from where, on which backend --
/// which is the question the visitors log answers for the rest of the site.
/// An assistant turn that does go on to run a remediation writes both: a row
/// here for the asking, and an AuditLogEntry for the doing.
///
/// Carries ip/country because it is merged into the visitors log, whose rows
/// are all "someone, somewhere, did this" -- and because the admin panel is
/// reachable from the public internet, so *where* an admin session is being
/// driven from is worth being able to see.
model AssistantUsage {
  id String @id @default(cuid())

  /// Admin's own name, not their user id -- same reasoning as
  /// AuditLogEntry.actorName: the row still reads clearly after a rename.
  actorName String

  /// Which model answered: "local", "open", or "claude". Stored per row
  /// rather than derived, since the picker can change between turns.
  backend String

  /// The admin's message, truncated -- enough to recognise the request
  /// without turning this table into an unbounded transcript store.
  prompt String

  ip      String
  country String?

  at DateTime @default(now())

  @@index([at])
}

// Which channel this user picked for a given game.
//
// A game page offers several plausible channels -- an EPG-confirmed match
// where one exists, then networks that merely carry the league -- and the
// first one is only ever a best guess. Switching away from it was a per-tab
// useState, so a reload, a phone handed to the TV, or simply coming back at
// halftime all silently dropped the correction and re-tuned to the guess.
//
// Keyed per user rather than globally: two people can be watching the same
// fixture on different providers, and one correcting their own pick has no
// business re-tuning the other's.
//
// Stores a name snapshot alongside the id, for the same reason
// HiddenChannelItem does: channels live in Jellyfin's tuner rather than in
// this database, and a playlist-backed tuner churns its ids whenever the
// source updates. The id is tried first and the name is the fallback, so a
// pick survives the overnight refresh that renumbers everything.
model GameChannelChoice {
  userId    String
  // The fixture id from sportsSchedule, as it appears in the page URL.
  fixtureId String
  channelId String
  name      String
  pickedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, fixtureId])
  @@index([userId])
  // Supports the opportunistic sweep of finished games on write.
  @@index([pickedAt])
}
