generator client {
  provider      = "prisma-client-js"
  // Docker build/run = Debian (see Dockerfile). `native` = local dev (macOS/Windows).
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  // Unique: the name is the login identifier and, until now, nothing stopped
  // two accounts sharing one -- including the admin's. Uniqueness is what makes
  // "the account called X" a single, unambiguous thing.
  name              String    @unique
  password          String
  // Gates login until an admin approves the account.
  approved          Boolean   @default(false)
  // Authorization source of truth. Admin used to be derived from a name/env
  // comparison held in the JWT, so it could not be revoked without waiting out
  // a 30-day token. ADMIN_NAME now only bootstraps the first admin; every
  // authorization decision reads this column.
  isAdmin           Boolean   @default(false)
  // Hex avatar background (e.g. #e50914); assigned on create / backfill on login.
  avatarColor       String?
  createdAt         DateTime  @default(now())
  // Stamped on every password change, and mirrored into the JWT at sign-in.
  // Sessions are stateless 30-day tokens, so changing a password otherwise
  // leaves every existing session -- including an attacker's -- valid. The jwt
  // callback compares the two and drops tokens issued before the change.
  passwordChangedAt DateTime?

  watchlist       WatchlistItem[]
  watchlistShows  WatchlistShowItem[]
  watchlistGames  WatchlistGameItem[]
  progress        WatchProgress[]
  episodeProgress EpisodeProgress[]
}

model WatchlistItem {
  userId  String
  movieId String
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([userId])
}

model WatchlistShowItem {
  userId  String
  showId  String
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, showId])
  @@index([userId])
}

model WatchProgress {
  userId          String
  movieId         String
  progressSeconds Int      @default(0)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([userId, updatedAt])
}

model EpisodeProgress {
  userId          String
  showId          String
  seasonNumber    Int
  episodeNumber   Int
  progressSeconds Int      @default(0)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, showId, seasonNumber, episodeNumber])
  @@index([userId, updatedAt])
}

// Shared/global per (tmdbId, mediaType) -- one Radarr/Sonarr library, not one
// per requesting user, so every user sees the same download status. Not tied
// to any User row: it represents library state, not personal data.
model MediaRequest {
  tmdbId      String
  // "movie" | "show"
  mediaType   String
  // Set for shows only, resolved via TMDB external_ids when the request is created.
  // Sonarr's webhook payload carries tvdbId, not tmdbId, so this is how we match it back.
  tvdbId      String?
  // "requested" | "downloading" | "available"
  status      String   @default("requested")
  // Radarr movie id / Sonarr series id -- used to look up live download progress.
  externalId  Int?
  requestedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([tmdbId, mediaType])
  @@index([tvdbId])
}

// Every sign-in attempt, successful or not.
//
// Two consumers: the lockout check in front of the login form, and the
// security monitor, which alerts when failures spike. Before this table there
// was no throttle and no evidence -- a brute-force run against the admin
// account would have left no trace at all.
//
// Not linked to User on purpose: the interesting rows are attempts against
// names that don't exist, and a foreign key would make those unstorable.
model LoginAttempt {
  id      String   @id @default(cuid())
  // As submitted. May not correspond to any User row.
  name    String
  ip      String
  success Boolean
  // "success" | "bad_password" | "unknown_user" | "not_approved" | "locked_out"
  outcome String
  at      DateTime @default(now())

  @@index([name, at])
  @@index([ip, at])
  @@index([at])
}

// Visits to the portfolio site, reported by a beacon on that site.
//
// jakobrossi.com is a static SPA on GitHub Pages with no server of its own, so
// it has nowhere to log. The beacon posts here instead, which keeps the
// portfolio a pure static site and puts the data on infrastructure that is
// already authenticated.
//
// Caveat worth knowing when reading the numbers: a JS beacon only sees clients
// that execute JavaScript. Bots, scanners, and curl are invisible to it. This
// answers "who is reading my site", not "what is probing my site".
model SiteVisit {
  id        String   @id @default(cuid())
  // Which property this came from, so other sites can report here later.
  site      String
  path      String
  ip        String
  // Best-effort, from the edge header if one is present.
  country   String?
  referrer  String?
  userAgent String?
  at        DateTime @default(now())

  @@index([at])
  @@index([site, at])
  @@index([ip, at])
}

/// A page being watched for changes. One row per URL.
model WatchedPage {
  id     String  @id @default(cuid())
  url    String  @unique
  /// Human name for the panel, e.g. "Fillmore listings".
  label  String
  /// The artist this page covers, when it covers exactly one. Left null for a
  /// venue or festival page listing many; those get their artist per date row.
  artist String?

  /// Narrows extraction to one container: "#tour" or ".listings". Whole page
  /// when null. Narrowing is what keeps nav and footer churn out of the diff.
  selector      String?
  /// Regex, one per line. Matching lines are dropped before hashing, so a
  /// clock or a rotating advert doesn't report a change on every check.
  ignorePattern String?
  /// Comma-separated. A keyword appearing in newly added content notifies.
  keywords      String?

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  /// Current state, overwritten each check.
  lastCheckedAt DateTime?
  lastStatus    String?
  lastError     String?
  contentHash   String?
  /// Normalized lines as last seen, newline-joined. This is the baseline the
  /// next check diffs against, so it is stored rather than re-fetched.
  content       String?
  failureCount  Int       @default(0)

  changes PageChange[]
  dates   TourDate[]

  @@index([enabled])
}

/// A detected change. History, so the panel can show what happened and when.
model PageChange {
  id          String      @id @default(cuid())
  pageId      String
  page        WatchedPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  detectedAt  DateTime    @default(now())
  /// One-line count, e.g. "3 added, 1 removed".
  summary     String
  /// The +/- lines, capped when written.
  diff        String
  /// Comma-separated keywords that appeared in this change, if any.
  keywordHits String?
  /// False when notification was skipped or failed, so it is visible that an
  /// email did not go out rather than assuming one did.
  notified    Boolean     @default(false)

  @@index([pageId, detectedAt])
  @@index([detectedAt])
}

/// A dated listing entry, as of the most recent successful check.
///
/// Replaced wholesale per page on each check rather than accumulated: the
/// overall view is meant to reflect what the sites say *now*, and keeping
/// removed dates around would make a cancelled show look live.
model TourDate {
  id     String      @id @default(cuid())
  pageId String
  page   WatchedPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// Denormalized from the page, or parsed per row for a multi-artist page.
  artist String
  /// ISO YYYY-MM-DD, or null when the line was dated too loosely to trust.
  date   String?
  detail String
  raw    String
  seenAt DateTime    @default(now())

  @@index([pageId])
  @@index([artist, date])
  @@index([date])
}

/// Small key/value store for runtime toggles the admin flips without a deploy.
/// First use: whether the tour watcher routes through the VPN egress proxy.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// One row per run of the download -> playback end-to-end check: grabs a
/// known-safe public-domain title through Radarr, waits for it to land, and
/// exercises the exact same HLS/seek chain a real viewer's player does,
/// before deleting it again. See lib/playbackCheck.ts.
///
/// A history table, not a single "last result" row (which Setting would have
/// been enough for) -- one bad run next to a long green streak reads very
/// differently from one bad run next to a week of red ones, and only a
/// history shows the difference.
model PlaybackCheckRun {
  id       String   @id @default(cuid())
  ranAt    DateTime @default(now())
  success  Boolean
  /// One line, e.g. "5/5 stages passed" or "failed at HLS transcode chain".
  summary  String
  /// Per-stage pass/fail detail, newline-separated.
  detail   String
  /// What this run downloaded and tested, e.g. "Night of the Living Dead (1968)".
  testTitle String?
  durationMs Int?
  /// False when the failure alert was skipped or failed to send, so that is
  /// visible in the admin panel rather than assumed to have gone out.
  notified Boolean  @default(false)

  @@index([ranAt])
}

/// A hand-picked artwork override for one ROM's Steam tile.
///
/// The Deck's steam_sync.py already auto-fetches artwork from SteamGridDB for
/// any game missing it, choosing the top-scoring match on its own. That's the
/// right default for an unattended import, but it has no way to be told "not
/// that one" -- and it picked wrong often enough to matter (a SpongeBob title
/// matching a 4-game compilation, "DreamWorks Madagascar" matching an
/// unrelated VR game) that overriding it needed to be possible without
/// editing files on the Deck by hand.
///
/// Keyed by the ROM's own identity (system + filename stem) rather than a
/// Steam appid: the appid is derived from the exe+name pair on the Deck and
/// isn't knowable here, and a ROM keeps this identity across re-imports and
/// across the .iso -> .chd conversion the compressor does. steam_sync.py
/// reads these via /api/games/artwork-overrides and prefers them over its own
/// automatic pick.
model GameArtwork {
  /// ES-DE system directory name, e.g. "ps2", "psx", "gamecube".
  system    String
  /// ROM filename without its extension, e.g. "DreamWorks Madagascar (USA) (v3.01)".
  romStem   String
  /// "grid" | "hero" | "logo" | "icon" -- the four assets a Steam tile uses.
  kind      String
  /// Full-size SteamGridDB asset URL to apply.
  imageUrl  String
  /// Which SteamGridDB game the picker resolved this ROM to, so the UI can
  /// reopen on the same game rather than re-searching by title every time.
  sgdbGameId Int?
  /// Display title shown in the admin list -- the ROM stem is not always
  /// readable on its own.
  title     String?
  updatedAt DateTime @updatedAt

  @@id([system, romStem, kind])
}

/// A game saved to a user's My List, alongside WatchlistItem (movies) and
/// WatchlistShowItem (shows).
///
/// Keyed by gameKey (see romNames.ts's gameKeyOf), not GameArtwork's
/// system+romStem: a game can be added to My List while still queued or
/// downloading, before either of those exist. gameKey is derived from title
/// alone and stays stable across a game's whole lifecycle (wishlisted ->
/// downloading -> owned), which is exactly what a list entry needs to survive.
model WatchlistGameItem {
  userId  String
  gameKey String
  /// Display title snapshot, so a row still shows something sensible if the
  /// game is later removed from gamarr entirely (unlike movies/shows, there's
  /// no external catalog left to re-look the title up from).
  title   String
  platform String
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, gameKey])
  @@index([userId])
}
